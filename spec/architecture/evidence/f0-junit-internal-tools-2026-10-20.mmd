flowchart TD
    A["同一 attempt 的完整工具请求"] --> B["宿主校验协议、参数、归属<br/>运行资格与总限额"]
    B --> C{"工具类型"}
    C -->|"课程"| D["searchCourse / readCourseEvidence<br/>沿用固定课程库代次"]
    D -->|"成功 / 正常无命中"| O["按 callId 配对有界工具观察"]
    D -->|"课程检索故障"| CF["F0 隔离与有限通识降级<br/>取消不走此分支"]
    CF --> BACK["回主图上下文节点<br/>同一 attempt 不重复首次检索"]
    C -->|"JUnit"| E["读取固定目标和已绑定用户需求"]
    E --> F{"代码重算用户场景长度<br/>且语义、修订有效？"}
    F -->|"长度为 0"| R["SCENARIO_REQUIRED<br/>内部生成模型调用为 0"]
    F -->|"歧义或过期"| Q["返回需澄清或更新的明确结果"]
    R --> O
    Q --> O
    F -->|"有效"| G["准备有界项目测试上下文<br/>占用父级次数、时间与预算"]
    G --> H["一次受控生成模型请求<br/>tools=[]，无内部循环或自动重试"]
    H -->|"完整、校验合格"| I["保存候选产物<br/>返回概要与产物引用"]
    I --> O
    O --> L{"预算、次数与状态允许继续？"}
    L -->|"是"| BACK
    L -->|"否"| STOP["终止并保留显示档案<br/>未完成内容无未来模型资格"]
    B -->|"取消 / 协议或开发故障"| STOP
    H -->|"取消 / 断流 / 超限 / 故障"| STOP
