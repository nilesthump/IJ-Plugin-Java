flowchart TD
    A["按钮批准<br/>或文字决定解析结束"] --> B["宿主核验真实批准证据<br/>精确候选版本、源码哈希与目的地"]
    B -->|"歧义 / 过期"| Q["澄清或更新候选，再由用户决定"]
    B -->|"有效"| C["按批准 writeId 检查幂等记录"]
    C -->|"已有成功回执"| DONE["返回实际文件名和 IDE 文件链接"]
    C -->|"原操作处理中"| STATE["返回原操作状态，不重复创建"]
    C -->|"原操作待恢复"| CHECK
    C -->|"新操作"| SLOT["取得新写入操作的 session 单槽"]
    SLOT --> D["复验项目、源码基线、测试根<br/>文件名与跨卡路径冲突"]
    D -->|"冲突 / 无明确测试根"| Q
    D -->|"有效"| E["耐久保存精确写入意图"]
    E -->|"失败"| FAIL["报告未创建"]
    E -->|"成功"| F["IDE 写命令内复验提交资格<br/>受限工具排他创建已批准源码"]
    F -->|"明确未创建"| FAIL
    F -->|"结果不明"| CHECK["待核对：只核验真实文件<br/>不盲目重写或重新生成"]
    F -->|"实际创建完成"| G["保存真实 fileRef、内容哈希与回执"]
    G -->|"成功"| DONE
    G -->|"回执保存失败"| REC["文件已创建，记录待恢复<br/>保留真实事实，只核验补记"]
