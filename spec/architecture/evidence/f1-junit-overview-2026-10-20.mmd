flowchart TD
    A["右键类名或方法：JUnit 测试"] --> B["固定目标源码与前台 session<br/>加入多张卡片，可增删"]
    B --> C["提交用户文字与卡片引用<br/>意图分析，逐卡绑定需求"]
    C --> D{"逐卡意图结果"}
    D -->|"缺失或歧义"| E["只追问该卡的测试需求<br/>结束本轮，等待用户"]
    E -->|"补充需求"| C
    E -->|"撤回目标"| W["移出有效上下文<br/>撤销尚未提交的生成与写入"]
    D -->|"撤回目标"| W
    D -->|"需求明确"| G{"代码重算场景长度"}
    G -->|"为 0：拒绝生成"| E
    G -->|"大于 0"| H["JUnit 工具内一次受控生成<br/>不启动第二个工具循环"]
    H -->|"失败或停止"| F["保留该卡状态与已接收前缀<br/>其他卡分别记录"]
    H -->|"完整且取得耐久资格"| I["候选卡：完整测试源码<br/>展示目标文件，等待用户"]
    I --> J{"用户决定<br/>按钮或明确文本"}
    J -->|"拒绝"| R["拒绝当前候选<br/>保留目标卡"]
    R -. "用户修改需求" .-> C
    J -->|"决定对象不明确"| Q["追问对应候选<br/>不写入文件"]
    Q --> J
    J -->|"同意并生成"| K["进入批准写入流程"]
    I -. "删除或撤回卡片" .-> W
