flowchart TD
    A["提交修改要求<br/>可选中代码，也可文字指定目标"] --> B["固定 session、原始指令<br/>及可选的选区快照"]
    B --> C[["复用 F0：首检、预算、模型循环"]]
    C -->|"定位目标 / 生成修改工具"| D[["内部 A：定位采集与候选生成"]]
    D -->|"工具观察：同一 attempt"| C
    C -->|"目标或要求不明"| Q["展示定位结果并追问，结束本轮"]
    Q -->|"用户补充：新一轮"| A
    C -->|"合格候选已有效耐久保存"| E["IDEA 内置 Diff<br/>固定原代码 ↔ 修改候选"]
    E --> F{"用户决定"}
    F -->|"调整要求 / 重新生成"| A
    F -->|"拒绝"| R["结束审核，源码不变"]
    F -->|"批准应用"| G[["内部 B：复验并应用获批修改"]]
    G -->|"应用成功"| H["展示实际结果与撤销入口"]
    G -->|"源码已变化"| S["旧候选失效，不覆盖新编辑"]
    S -->|"用户要求重新生成"| A
    G -->|"失败 / 待核对"| X["显示真实状态并收口"]
