flowchart TD
    A["完整 proposeCodeEdit 请求"] --> B["宿主解析已采集 snapshotRef<br/>核验用户指令、真实目标与允许范围"]
    B -->|"尚未定位 / 指令不明确"| Q["返回定位或需求追问结果"]
    B -->|"有效"| C["构造有界上下文<br/>沿用父级预算、时间与取消"]
    C --> D["一次受控生成：tools=[]<br/>只产生修改候选"]
    D -->|"完整正常结束"| E["校验原文匹配、允许范围<br/>修改块不重叠及输出结构"]
    E -->|"无变化 / 无效"| RESULT["返回明确业务结果"]
    E -->|"合格"| P["在不可变 before 副本上构造 after<br/>绑定准确哈希与候选版本"]
    P --> O["暂存候选，返回有界观察与产物引用"]
    Q --> BACK["返回唯一 F0 循环<br/>继续核算预算或结束本轮"]
    RESULT --> BACK
    O --> BACK
    BACK -->|"存在合格候选且父轮次有效耐久收口"| READY["可打开完整只读 Diff<br/>等待用户时无活跃任务占用"]
    D -->|"中断 / 超限 / 故障"| STOP["保留不可批准的显示档案<br/>排除后续模型资格"]
