flowchart TD
    A["同意并生成<br/>按钮或明确文本"] --> B["宿主绑定精确候选版本、内容哈希<br/>目标快照、测试根与文件名"]
    B --> C{"批准仍有效且无路径冲突？"}
    C -->|"否"| X["报告过期或冲突<br/>更新候选后重新批准"]
    C -->|"是"| D["保存写入意图并检查幂等记录"]
    D -->|"已有成功结果"| H["返回真实文件名<br/>渲染 IDE 跳转链接"]
    D -->|"新写入"| E["受限文件工具<br/>排他创建批准的测试源码"]
    E -->|"创建完成"| F["保存真实文件引用与内容回执"]
    F -->|"记录成功"| H
    F -->|"记录失败"| R["文件已创建，记录待恢复<br/>只核验和补记录，不重复创建"]
    E -->|"失败或结果待核对"| G["逐卡报告失败或待恢复<br/>保留其他已创建文件"]
