flowchart TD
    A["收到完整 proposeCodeEdit 请求"] --> B["宿主读取提交时固定的 Document 快照<br/>核验需求、目标及允许范围"]
    B -->|"需求不明 / 范围不足"| Q["返回需澄清或扩展范围的结果"]
    B -->|"有效"| C["构造有界生成上下文<br/>沿用父级预算、时间与取消"]
    C --> D["一次受控模型调用：tools=[]<br/>输出结构化修改，不直接写项目"]
    D -->|"正常完整结束"| E["验证修改范围、原文匹配<br/>修改块无重叠，结构可解析"]
    E -->|"无实际变化"| N["返回无需修改"]
    E -->|"不合法 / 超范围"| BAD["返回明确候选错误"]
    E -->|"合格"| P["在固定副本上构造 after<br/>绑定 before/after 哈希及版本"]
    P --> O["暂存不可变候选产物<br/>配对 toolCallId 返回引用与概要"]
    Q --> OBS["回共享 F0 循环<br/>重新核算预算或结束"]
    BAD --> OBS
    N --> OBS
    O --> OBS
    OBS -->|"有合格候选，且父轮次有效耐久收口"| READY["候选可审核：打开只读快照 Diff<br/>等待用户时不占活跃槽"]
    OBS -->|"追问 / 无需修改"| END["保存本轮说明并释放槽"]
    B -->|"取消 / 非法协议"| STOP["明确终止，保留显示档案<br/>未完成候选不可批准或进入未来模型"]
    D -->|"中断 / 超限 / 故障"| STOP
