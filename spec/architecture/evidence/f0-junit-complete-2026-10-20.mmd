flowchart TD
    subgraph INPUT["输入与固定：沿用 F0 入口"]
        A["普通问题 / F0 代码选区<br/>或右键类、方法：JUnit 测试"] --> B["前台 session 草稿<br/>文字、代码、多张 JUnit 卡片，可增删"]
        B --> C["用户提交问题或后续文字<br/>补需求、撤回、同意或拒绝"]
        C --> D["宿主校验归属、版本、单槽和去重<br/>事务固定输入、源码、卡片与历史边界"]
    end

    subgraph LOOP["共享 F0 ReAct 主流程"]
        D --> E["每个新 attempt 首次课程检索<br/>固定代次，必要时等待索引恢复"]
        E -->|"命中 / 无命中 / 未建库"| F["组装完整上下文与依据声明<br/>有效卡片、需求、证据、历史、tag 和工具"]
        E -->|"课程检索故障"| CF["按 F0 策略提示、隔离旧分支<br/>禁用课程工具，有限通识降级"]
        CF --> F
        F --> G["核算完整输入、输出预留及剩余预算"]
        G --> H["Spring AI 调用模型<br/>问答、逐卡意图分析、追问与工具选择"]
        H --> I{"完整模型输出"}

        I -->|"绑定 / 撤回 / 拒绝等结构化意图"| IP["宿主核验用户原文、对象和修订<br/>提交逐卡绑定或有效上下文变更"]
        IP --> LIMIT
        I -->|"识别到明确文本批准"| TA["宿主核验批准范围与原文<br/>结束解析操作，转入写入入口"]

        I -->|"结构化工具请求"| J["宿主校验完整参数、允许范围<br/>卡片资格、运行状态及工具限额"]
        J --> K{"工具类型"}
        K -->|"课程工具"| L["searchCourse / readCourseEvidence<br/>沿用 attempt 固定代次"]
        L -->|"成功或正常无命中"| O
        L -->|"检索故障"| CF

        K -->|"JUnit 生成工具"| M{"代码重算该卡用户场景长度"}
        M -->|"为 0"| N["拒绝该卡生成：SCENARIO_REQUIRED<br/>内部生成模型调用为 0"]
        N --> O
        M -->|"大于 0 且需求有效"| P["一次受控 JUnit 生成<br/>固定源码和需求，禁用内部工具循环"]
        P -->|"完整候选或明确业务结果"| O["配对工具结果与 callId<br/>固定课程证据 / 测试产物引用 / 业务错误"]

        O --> LIMIT{"总预算、次数、时间和状态<br/>是否允许继续？"}
        LIMIT -->|"允许"| F
        LIMIT -->|"不允许"| STOP["停止并说明<br/>保留已接受内容，排除未完成生成的未来资格"]
        J -->|"取消或协议故障"| STOP
        P -->|"停止 / 断流 / 超限"| STOP
        G -->|"预算不足且无法合法压缩"| STOP

        I -->|"普通回答 / 追问 / 候选说明"| Q["流式显示最终步骤正文<br/>核对实际引用、完整性及终态资格"]
        Q --> S["耐久保存有效回答、候选与状态<br/>释放本轮活跃槽"]
    end

    subgraph REVIEW["展示与人审：两次用户提交之间"]
        S --> T["展示普通回答、逐卡追问<br/>或完整源码候选卡"]
        T --> U{"用户下一步"}
        U -->|"新问题 / 补需求 / 文字决定"| C
        U -->|"拒绝候选 / 删除目标卡"| V["宿主更新候选或撤回卡片<br/>撤销尚未提交的写入资格"]
        V --> T
        U -->|"点击同意并生成"| W
    end

    subgraph WRITE["批准后的文件创建：宿主驱动受限工具"]
        TA --> W["新写入操作：同一 session 单槽<br/>固定批准的候选版本、源码哈希及目的地"]
        W --> X{"批准有效、源码基线有效<br/>测试根与文件名无冲突？"}
        X -->|"否"| Y["报告过期或冲突<br/>更新候选后重新批准"]
        Y --> T
        X -->|"是"| Z["持久化写入意图并检查幂等记录"]
        Z -->|"已有成功结果"| DONE["回复实际文件名<br/>渲染可跳转 IDE 文件链接"]
        Z -->|"新写入"| CREATE["调用受限文件写入工具<br/>排他创建已批准的测试源码"]
        CREATE -->|"文件创建完成"| RECEIPT["保存真实文件引用、内容哈希及回执"]
        RECEIPT -->|"成功"| DONE
        RECEIPT -->|"回执保存失败"| RECOVER["文件已创建，记录待恢复<br/>只核验补记，不重新生成或重复创建"]
        CREATE -->|"未创建或结果待核对"| FAIL["逐卡报告失败或待恢复<br/>保留其他已经创建的文件"]
    end
