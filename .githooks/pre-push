#!/bin/sh
# Git supplies local ref/OID and destination ref/OID on standard input.
is_zero() {
    case "$1" in
        ''|*[!0]*) return 1 ;;
        *) return 0 ;;
    esac
}

while read -r local_ref local_oid remote_ref remote_oid
do
    case "$remote_ref" in
        refs/heads/main|refs/heads/dev-manager|refs/heads/dev-a|refs/heads/dev-b|refs/heads/dev-c)
            if is_zero "$local_oid"; then
                printf '%s\n' "Branch policy: deleting a fixed remote branch is forbidden: $remote_ref" >&2
                exit 1
            fi
            if ! is_zero "$remote_oid"; then
                if ! git cat-file -e "$remote_oid^{commit}" 2>/dev/null; then
                    printf '%s\n' "Branch policy: fetch the remote before updating $remote_ref; its previous commit is unknown locally." >&2
                    exit 1
                fi
                if ! git merge-base --is-ancestor "$remote_oid" "$local_oid"; then
                    printf '%s\n' "Branch policy: non-fast-forward updates are forbidden: $remote_ref" >&2
                    exit 1
                fi
            fi
            ;;
        refs/heads/*)
            printf '%s\n' "Branch policy: pushing an additional branch is forbidden: $remote_ref" >&2
            exit 1
            ;;
    esac
done
exit 0
