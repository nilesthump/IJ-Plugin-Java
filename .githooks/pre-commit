#!/bin/sh
# Windows MVP: delegate staged-path validation to the shared repository check.
repo_root=$(git rev-parse --show-toplevel) || exit 1
scope_check="$repo_root/scripts/check-scope.ps1"
if [ ! -f "$scope_check" ]; then
    printf '%s\n' 'Commit policy: missing scripts/check-scope.ps1; restore repository governance before committing.' >&2
    exit 1
fi
if command -v powershell.exe >/dev/null 2>&1; then
    exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$scope_check" -Staged
fi
if command -v pwsh.exe >/dev/null 2>&1; then
    exec pwsh.exe -NoProfile -ExecutionPolicy Bypass -File "$scope_check" -Staged
fi
if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoProfile -File "$scope_check" -Staged
fi
printf '%s\n' 'Commit policy: PowerShell is required for the Windows MVP staged-path check.' >&2
exit 1
