<idea-plugin>
    <id>edu.courseassist.f0</id>
    <name>Course Assistant F0</name>
    <vendor>F0 Team</vendor>
    <description><![CDATA[
        F0 course assistant development baseline. Course RAG, session persistence,
        model integration and final UI are assigned work; this bootstrap is not a finished assistant.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <extensionPoints>
        <extensionPoint name="codeCapture" interface="edu.courseassist.contract.CodeCapturePort" dynamic="true"/>
        <extensionPoint name="pdfReader" interface="edu.courseassist.contract.PdfReader" dynamic="true"/>
    </extensionPoints>
    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="edu.courseassist.bootstrap.CourseAssistantApplication"/>
        <projectService serviceImplementation="edu.courseassist.bootstrap.CourseAssistantProject"/>
        <toolWindow id="Course Assistant" anchor="right"
                    factoryClass="edu.courseassist.bootstrap.BootstrapToolWindowFactory"/>
    </extensions>
</idea-plugin>
